# Zmienne środowiskowe dla Discord Soundboard Bot
# Skopiuj ten plik jako .env i uzupełnij wartości:
#   cp .env.example .env

# Token bota Discord (wymagany)
# Pobierz na: https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=twój_token_tutaj

# Ścieżka do katalogu z plikami dźwiękowymi (opcjonalnie, domyślnie: sounds/)
# SOUNDS_DIR=sounds

# Głośność odtwarzania: 0.0 (cisza) – 1.0 (pełna głośność), domyślnie 0.5
# VOLUME=0.5
